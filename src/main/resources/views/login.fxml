<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.6"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.uzlezz.crypman.gui.controllers.LoginController"
      stylesheets="@material.css">

    <ImageView fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true">
        <Image url="@../images/logo150.png"/>
    </ImageView>

    <Text text="Авторизация" styleClass="title"/>

    <Separator prefWidth="300"/>

    <TextField fx:id="usernameField" maxWidth="300" promptText="Имя пользователя" styleClass="md-input"/>
    <PasswordField fx:id="passwordField" maxWidth="300" promptText="Пароль" styleClass="md-input"/>

    <Button maxWidth="200" onAction="#onLoginButtonPressed" text="Войти" styleClass="md-button, md-primary"/>

    <Separator prefWidth="300"/>

    <Button maxWidth="200" onAction="#onRegButtonPressed" text="Регистрация" styleClass="md-button"/>
</VBox>

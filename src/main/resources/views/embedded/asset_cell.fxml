<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<?import javafx.geometry.Insets?>
<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="net.uzlezz.crypman.gui.controllers.embedded.AssetCellController"
      spacing="10" alignment="TOP_LEFT">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>
    <ImageView fx:id="iconView" fitWidth="40" fitHeight="40" />

    <VBox alignment="TOP_LEFT" spacing="2" HBox.hgrow="ALWAYS">
        <HBox alignment="TOP_LEFT" spacing="10">
            <Label fx:id="nameLabel" style="-fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS" />

            <!--<Label fx:id="priceLabel" style="-fx-font-size: 14px;" alignment="CENTER_RIGHT" />-->
            <VBox alignment="CENTER_RIGHT" spacing="0">
                <Label fx:id="priceLabel" style="-fx-font-size: 14px; -fx-text-fill: #1f1f1f;" />
                <Label fx:id="secondaryPriceLabel" style="-fx-font-size: 12px; -fx-text-fill: gray;" />
            </VBox>
        </HBox>
        <AnchorPane BorderPane.alignment="CENTER">
            <Label fx:id="amountLabel" style="-fx-text-fill: #1f1f1f;" />
        </AnchorPane>
    </VBox>

</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ebebeb; -fx-padding: 40;" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.uzlezz.crypman.gui.controllers.MarketControlController">

    <HBox alignment="CENTER_LEFT" prefHeight="50" spacing="10" style="-fx-background-color: #f0f0f0; -fx-padding: 10;">
        <Label fx:id="usernameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#onRefreshButtonPressed" style="-fx-background-color: #b3b3b3; -fx-text-fill: #1f1f1f; -fx-font-size: 14; -fx-padding: 10; -fx-border-radius: 5;" text="Обновить" />
        <Button onAction="#onBackButtonPressed" style="-fx-background-color: #b3b3b3; -fx-text-fill: #1f1f1f; -fx-font-size: 14; -fx-padding: 10; -fx-border-radius: 5;" text="Назад" />
    </HBox>
    <Separator prefWidth="600" style="-fx-background-color: #b5b5b5;" />

    <Text style="-fx-fill: #1f1f1f;" text="Управление рынком">
        <font>
            <Font name="Helvetica Neue" size="24" />
        </font>
    </Text>

    <TableView fx:id="cryptoTableView" prefWidth="450.0" prefHeight="300.0" layoutX="10" layoutY="10">
        <columns>
            <TableColumn fx:id="nameColumn" text="Идентификатор" prefWidth="150.0"/>
            <TableColumn fx:id="friendlyNameColumn" text="Имя" prefWidth="150.0"/>
            <TableColumn fx:id="iconColumn" text="Иконка" prefWidth="150.0"/>
        </columns>
    </TableView>

</VBox>

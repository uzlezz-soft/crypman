<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="800" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.uzlezz.crypman.gui.controllers.dialogs.AssetSellDialogController">
    <center>
        <VBox style="-fx-padding: 20 20 20 20">
            <SplitPane dividerPositions="0.7" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                <ListView fx:id="assetListView" />
                <VBox style="-fx-padding: 5 5 5 5">
                    <HBox>
                        <Label fx:id="totalReturnsLabel" text="\$0.00" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Label fx:id="balanceLabel" text="Баланс: $0.00" />
                    </HBox>
                </VBox>
            </SplitPane>
            <HBox style="-fx-padding: 5 0 0 0">
                <Pane HBox.hgrow="ALWAYS" />
                <Button onAction="#onConfirmButtonPressed" text="Подтвердить" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

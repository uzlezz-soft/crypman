<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="net.uzlezz.crypman.gui.controllers.PortfolioController"
            styleClass="root" stylesheets="@material.css">

    <top>
        <VBox spacing="5">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="md-toolbar">
                <Label fx:id="usernameLabel" styleClass="primary bold" />
                <Label fx:id="balanceLabel" styleClass="primary" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="marketControlButton" onAction="#onNewButtonPressed" text="Управление"
                        styleClass="md-button, md-primary" visible="false"/>
                <Button text="Пополнить баланс" onAction="#addMoneyButtonPressed"
                        styleClass="md-button, md-primary"/>
                <Button text="Купить" onAction="#buyButtonPressed"
                        styleClass="md-button, md-primary"/>
                <Button text="Продать" onAction="#sellButtonPressed"
                        styleClass="md-button, md-primary"/>
                <Button onAction="#onRefreshButtonPressed" text="Обновить"
                        styleClass="md-button"/>
                <Button onAction="#onLogoutButtonPressed" text="Выйти"
                        styleClass="md-button"/>
            </HBox>
            <Separator styleClass="form-separator"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20" VBox.vgrow="ALWAYS">
            <Text text="Портфель" styleClass="title"/>
            <Text fx:id="totalPriceText" text="\$69.00" textAlignment="CENTER"
                  styleClass="primary"/>

            <SplitPane dividerPositions="0.5" orientation="HORIZONTAL" VBox.vgrow="ALWAYS">
                <TabPane side="BOTTOM" tabClosingPolicy="UNAVAILABLE">
                    <Tab text="Активы">
                        <ListView fx:id="assetListView"/>
                    </Tab>
                    <Tab text="История операций">
                        <BorderPane styleClass="dialog-root">
                            <center>
                                <ListView fx:id="portfolioHistoryListView"/>
                            </center>
                            <bottom>
                                <Button onAction="#exportPortfolioHistoryButtonPressed"
                                        text="Экспортировать в файл"
                                        styleClass="md-button"/>
                            </bottom>
                        </BorderPane>
                    </Tab>
                </TabPane>

                <VBox alignment="TOP_CENTER" spacing="10" VBox.vgrow="ALWAYS">
                    <ComboBox fx:id="chartTypeComboBox" onAction="#onChartTypeChanged"
                              prefWidth="200" styleClass="md-input"/>
                    <LineChart fx:id="priceChart" animated="false" createSymbols="false"
                               legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis fx:id="xAxis" label="Время"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="yAxis" label="Стоимость"/>
                        </yAxis>
                    </LineChart>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ebebeb; -fx-padding: 40;" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="net.uzlezz.crypman.gui.controllers.PortfolioController">

    <HBox alignment="CENTER_LEFT" prefHeight="50" spacing="10" style="-fx-background-color: #f0f0f0; -fx-padding: 10;">
        <Label fx:id="usernameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#onNewButtonPressed" style="-fx-background-color: #b3b3b3; -fx-text-fill: #1f1f1f; -fx-font-size: 14; -fx-padding: 10; -fx-border-radius: 5;" text="Управление" fx:id="marketControlButton" visible="false" />
        <Button onAction="#onRefreshButtonPressed" style="-fx-background-color: #b3b3b3; -fx-text-fill: #1f1f1f; -fx-font-size: 14; -fx-padding: 10; -fx-border-radius: 5;" text="Обновить" />
        <Button onAction="#onLogoutButtonPressed" style="-fx-background-color: #b3b3b3; -fx-text-fill: #1f1f1f; -fx-font-size: 14; -fx-padding: 10; -fx-border-radius: 5;" text="Выйти" />
    </HBox>
    <Separator prefWidth="600" style="-fx-background-color: #b5b5b5;" />

    <Text style="-fx-fill: #1f1f1f;" text="Портфель">
        <font>
            <Font name="Helvetica Neue" size="24" />
        </font>
    </Text>
   <Text fx:id="totalPriceText" fill="#363636" strokeType="OUTSIDE" strokeWidth="0.0" text="\$69.00" textAlignment="CENTER">
      <font>
         <Font size="15.0" />
      </font>
   </Text>

    <ListView fx:id="assetListView" layoutX="10" layoutY="10" prefHeight="400" prefWidth="600" />

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<VBox alignment="CENTER" spacing="20.0" stylesheets="@material.css"
      xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="net.uzlezz.crypman.gui.controllers.RegisterController">

    <ImageView fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true">
        <Image url="@../images/logo150.png" />
    </ImageView>

    <Text styleClass="title" text="Регистрация" />
    <Separator prefWidth="300" />

    <TextField fx:id="usernameField" maxWidth="300" promptText="Имя пользователя"
               styleClass="md-input" />
    <PasswordField fx:id="passwordField" maxWidth="300" promptText="Пароль"
                   styleClass="md-input" />
    <PasswordField fx:id="confirmationPasswordField" maxWidth="300" promptText="Подтвердите пароль"
                   styleClass="md-input" />

    <Button maxWidth="200" onAction="#onRegButtonPressed" text="Зарегистрироваться"
            styleClass="md-button,md-primary" />

    <Separator prefWidth="300" />

    <Button maxWidth="200" onAction="#onLoginButtonPressed" text="Авторизация"
            styleClass="md-button,md-secondary" />
</VBox>
